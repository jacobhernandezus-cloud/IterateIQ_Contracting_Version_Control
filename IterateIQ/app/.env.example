# Copy this file to .env.local and fill in real values from your Supabase project.
# .env.local is gitignored — never commit credentials.

# Supabase project URL — find it at https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon (public) API key — safe to expose to the browser; RLS protects the data
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
